use RedisClient as RC

module RedisQueuedLocks
  class Swarm
    class FlushZombies < SwarmElement::Isolated
      type flushedZombies = { ok: bool, deleted_zombie_hosts: Set[String], deleted_zombie_acquirers: Set[String], deleted_zombie_locks: Set[String] }
      def self.flush_zombies: (RC::client redis_client, Integer zombie_ttl, Integer lock_scan_size, Integer queue_scan_size) -> flushedZombies
      private def self.flush_zombie_locks: (
        RC::client redis_client,
        Array[String] lock_keys,
        Set[String] zombie_hosts,
        Set[String] zombie_locks,
        Set[String] zombie_acquirers
      ) -> void
      private def self.flush_zombie_read_locks: (
        RC::client redis_client,
        Array[String] lock_readers_keys,
        Set[String] zombie_hosts,
        Set[String] zombie_locks,
        Set[String] zombie_acquirers
      ) -> void
      private def self.flush_zombie_requests: (
        RC::client redis_client,
        Array[String] lock_queues,
        Set[String] zombie_hosts,
        Set[String] zombie_acquirers
      ) -> void

      def enabled?: () -> bool
      def spawn_swarm_element!: (Ractor::Port[SwarmElement::Isolated::resultsPortMessage] swarm_element_results_port) -> Ractor
    end
  end
end
