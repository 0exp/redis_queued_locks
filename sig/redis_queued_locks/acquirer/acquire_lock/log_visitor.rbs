use RedisQueuedLocks as RQL

module RedisQueuedLocks
  module Acquirer
    module AcquireLock
      module LogVisitor
        def self.start_lock_obtaining: (
          RQL::loggerObj logger,
          bool log_sampled,
          String lock_key,
          Integer queue_ttl,
          String acquirer_id,
          String host_id,
          RQL::accessStrategy access_strategy,
          RQL::readWriteMode rw_mode,
          Integer priority
        ) -> void

        def self.start_try_to_lock_cycle: (
          RQL::loggerObj logger,
          bool log_sampled,
          String lock_key,
          Integer queue_ttl,
          String acquirer_id,
          String host_id,
          RQL::accessStrategy access_strategy,
          RQL::readWriteMode rw_mode,
          Integer priority
        ) -> void

        def self.dead_score_reached__reset_acquirer_position: (
          RQL::loggerObj logger,
          bool log_sampled,
          String lock_key,
          Integer queue_ttl,
          String acquirer_id,
          String host_id,
          RQL::accessStrategy access_strategy,
          RQL::readWriteMode rw_mode,
          Integer priority
        ) -> void

        def self.extendable_reentrant_lock_obtained: (
          RQL::loggerObj logger,
          bool log_sampled,
          String lock_key,
          Integer queue_ttl,
          String acquirer_id,
          String host_id,
          Integer|Float acq_time,
          RQL::accessStrategy access_strategy,
          RQL::readWriteMode rw_mode,
          Integer priority
        ) -> void

        def self.reentrant_lock_obtained: (
          RQL::loggerObj logger,
          bool log_sampled,
          String lock_key,
          Integer queue_ttl,
          String acquirer_id,
          String host_id,
          Integer|Float acq_time,
          RQL::accessStrategy access_strategy,
          RQL::readWriteMode rw_mode,
          Integer priority
        ) -> void

        def self.lock_obtained: (
          RQL::loggerObj logger,
          bool log_sampled,
          String lock_key,
          Integer queue_ttl,
          String acquirer_id,
          String host_id,
          Integer|Float acq_time,
          RQL::accessStrategy access_strategy,
          RQL::readWriteMode rw_mode,
          Integer priority
        ) -> void

        def self.lock_obtaining_failed: (
          RQL::loggerObj logger,
          bool log_sampled,
          String lock_key,
          Integer queue_ttl,
          String acquirer_id,
          String host_id,
          Integer|Float acq_time,
          RQL::accessStrategy access_strategy,
          RQL::readWriteMode rw_mode,
          Integer priority,
          Symbol result
        ) -> void
      end
    end
  end
end
