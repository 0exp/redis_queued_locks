use RedisQueuedLocks as RQL
use RedisClient as RC

module RedisQueuedLocks
  module Acquirer
    module ClearDeadRequests
      extend RQL::Utilities

      type clearResult = { ok: bool, result: { processed_queues: Set[String] } }
      def self.clear_dead_requests: (
        RC::client redis_client,
        Integer scan_size,
        Integer dead_ttl,
        bool lock_index_enabled,
        RQL::loggerObj logger,
        RQL::instrObj instrumenter,
        untyped? instrument,
        bool log_sampling_enabled,
        Integer log_sampling_percent,
        RQL::Logging::samplerObj log_sampler,
        bool log_sample_this,
        bool instr_sampling_enabled,
        Integer instr_sampling_percent,
        RQL::Instrument::samplerObj instr_sampler,
        bool instr_sample_this
      ) -> clearResult

      private def self.fully_clear_dead_requests: (
        RC::client redis_client,
        Integer scan_size,
        Integer dead_ttl,
        bool lock_index_enabled
      ) -> Set[String]

      private def self.each_lock_queue: (RC::client redis_client, Integer scan_size) { (String lock_queue) -> void } -> void
      private def self.drop_dead_requests: (RC::client redis_client, Array[String] lock_queues, Float dead_score) -> void
      private def self.drop_dead_requests_of_locks: (
        RC::client redis_client,
        Array[String] lock_names,
        Float dead_score,
        Set[String] processed_queues
      ) -> void
      private def self.each_lock_name_batch: (RC::client redis_client, Integer scan_size) { (Array[String] lock_names) -> void } -> void
    end
  end
end
