        def self.lock_series_obtaining_failed: (
          RQL::loggerObj logger,
          bool log_sampled,
          Array[String] lock_keys,
          Integer queue_ttl,
          String acquirer_id,
          String host_id,
          Integer|Float acq_time,
          RQL::accessStrategy access_strategy,
          RQL::readWriteMode rw_mode,
          Integer priority,
          Symbol result,
          String? failed_lock_key
        ) -> void

        def self.decrease_lock_series: (
          RQL::loggerObj logger,
          bool log_sampled,
          Array[String] lock_keys,
          Integer decreased_ttl,
          Integer queue_ttl,
          String acquirer_id,
          String host_id,
          RQL::accessStrategy access_strategy,
          RQL::readWriteMode rw_mode,
          Integer priority
        ) -> void
