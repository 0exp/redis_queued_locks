use RedisClient as RC

module RedisQueuedLocks
  module Acquirer
    module Locks
      type readerInfo = Hash[String,String|Float|Integer|nil]
      type lockInfo = Hash[String,String|Float|Integer|Array[readerInfo]]
      type lockList = Set[String]
      type locksInfo = Set[{ lock: String, status: Symbol, info: lockInfo }]
      type locks = lockList | locksInfo

      LOCK_STATE_REPLIES: Integer

      def self.locks: (RC::client redis_client, scan_size: Integer, with_info: bool) -> locks

      private def self.index_locks: (RC::client redis_client, Integer scan_size) -> lockList
      private def self.each_lock_name_batch: (RC::client redis_client, Integer scan_size) { (Array[String] lock_names) -> void } -> void
      private def self.extract_locks_info: (RC::client redis_client, Set[::String] lock_keys, Integer scan_size) -> locksInfo
      private def self.read_lock_info: (
        String lock_key,
        Integer now,
        Array[[String, Float]] live_read_locks,
        Array[Hash[String,String]] read_locks_data,
        Integer read_locks_data_at
      ) -> lockInfo?
    end
  end
end
