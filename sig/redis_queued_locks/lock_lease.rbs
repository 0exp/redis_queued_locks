use RedisQueuedLocks as RQL
use RedisClient as RC

module RedisQueuedLocks
  class LockLease
    type holdForResult = { ok: bool, result: :extended | :lock_lost | :hold_limit_reached | :released }

    @lock_keeper: RQL::LockKeeper
    @lease: RQL::LockKeeper::Lease
    @redis: RC::client

    def initialize: (RQL::LockKeeper lock_keeper, RQL::LockKeeper::Lease lease, RC::client redis) -> void
    def hold_for: (Integer hold_time) -> holdForResult
    def lost?: () -> bool
    def hold_time_left: () -> Integer?
  end
end
