use RedisQueuedLocks as RQL

module RedisQueuedLocks
  class LockKeeper
    module InstrVisitor
      def self.lock_auto_extended: (
        RQL::instrObj instrumenter,
        bool instr_sampled,
        String lock_key,
        RQL::readWriteMode rw_mode,
        Integer ext_ttl,
        Integer rem_ttl,
        String acq_id,
        String hst_id,
        untyped? instrument
      ) -> void

      def self.lock_auto_extension_failed: (
        RQL::instrObj instrumenter,
        bool instr_sampled,
        String lock_key,
        RQL::readWriteMode rw_mode,
        Integer ext_ttl,
        String acq_id,
        String hst_id,
        String error,
        untyped? instrument
      ) -> void

      def self.auto_extended_lock_lost: (
        RQL::instrObj instrumenter,
        bool instr_sampled,
        String lock_key,
        RQL::readWriteMode rw_mode,
        String acq_id,
        String hst_id,
        Integer hold_time,
        untyped? instrument
      ) -> void

      def self.lock_hold_limit_reached: (
        RQL::instrObj instrumenter,
        bool instr_sampled,
        String lock_key,
        RQL::readWriteMode rw_mode,
        Integer? max_hold_time,
        String acq_id,
        String hst_id,
        untyped? instrument
      ) -> void
    end
  end
end
