module RedisQueuedLocks
  module Resource
    KEY_PATTERN: String
    LOCK_PATTERN: String
    LOCK_QUEUE_PATTERN: String
    READ_LOCK_QUEUE_PATTERN: String
    LOCK_READERS_PATTERN: String
    READ_LOCK_PATTERN: String
    ALL_LOCK_QUEUES_PATTERN: String
    SWARM_KEY: String
    LOCK_INDEX_KEY: String
    REDIS_TIMESHIFT_ERROR: Integer

    def self.calc_uniq_identity: () -> String
    def self.acquirer_identifier: (
      Integer|String process_id,
      Integer|String thread_id,
      Integer|String fiber_id,
      Integer|String ractor_id,
      String identity
    ) -> String

    def self.host_identifier: (
      Integer|String process_id,
      Integer|String thread_id,
      Integer|string ractor_id,
      String identity
    ) -> String

    # NOTE: (rbs test) `%a{rbs:test:skip}`: these functions run inside the zombie flusher Ractor
    #   (`FlushZombies.flush_zombies`); rbs/test hooks read `RBS.logger` and raise
    #   `Ractor::IsolationError` there, so they are not hooked (Steep still checks them).
    %a{rbs:test:skip} def self.prepare_lock_key: (String lock_name) -> String
    %a{rbs:test:skip} def self.prepare_lock_queue: (String lock_name) -> String
    %a{rbs:test:skip} def self.prepare_read_lock_queue: (String lock_name) -> String
    %a{rbs:test:skip} def self.prepare_lock_readers: (String lock_name) -> String
    %a{rbs:test:skip} def self.prepare_read_lock_key: (String lock_name, String acquirer_id) -> String
    def self.lock_queue_rw_mode: (String lock_queue) -> String?
    type lockKeyFamily = :lock | :lock_queue | :lock_readers | :read_lock_queue | :read_lock
    %a{rbs:test:skip} def self.lock_key_family: (String key) -> lockKeyFamily?
    def self.lock_name_from_key: (String key, lockKeyFamily? key_family) -> String?
    %a{rbs:test:skip} def self.lock_index_time: () -> Integer
    %a{rbs:test:skip} def self.lock_name_from_readers: (String lock_readers_key) -> String
    def self.lock_key_from_readers: (String lock_readers_key) -> String
    %a{rbs:test:skip} def self.host_identifier_from_acquirer: (String acquirer_id) -> String
    def self.redis_time_ms: (Array[String] redis_time) -> Integer
    def self.calc_initial_acquirer_position: () -> Float
    def self.acquirer_dead_score: (Integer|Float queue_ttl) -> Float
    %a{rbs:test:skip} def self.calc_zombie_score: (Float zombie_ttl) -> Float
    def self.dead_score_reached?: (Float acquirer_position, Integer queue_ttl) -> bool
    def self.lock_key_from_queue: (String lock_queue) -> String?
    def self.get_thread_id: () -> Integer
    def self.get_fiber_id: () -> Integer
    def self.get_ractor_id: () -> Integer
    def self.get_process_id: () -> Integer
    def self.possible_host_identifiers: (String identity) -> Array[String]
  end
end
