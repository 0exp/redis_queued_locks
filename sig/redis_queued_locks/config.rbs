module RedisQueuedLocks
  class Config
    include RedisQueuedLocks::Config::DSL
    include RedisQueuedLocks::Config::DSL::InstanceMethods
    extend RedisQueuedLocks::Config::DSL::ClassMethods

    type configState = Hash[String,untyped]

    @config_state: configState
    @configuring: bool
    # NOTE: (rbs test) `%a{rbs:test:skip}`: the hottest call of the runtime checks: it runs twice
    #   per `config['...']` (`Client#lock` reads ~25 defaults) and rbs/test walks every key of the
    #   hash on each call; the values stay checked per key by the `Config#[]` overloads (Steep still
    #   checks the reader).
    %a{rbs:test:skip} attr_reader config_state: configState

    def initialize: () ?{ (RedisQueuedLocks::Config) -> void } -> void
    def configure: () ?{ (RedisQueuedLocks::Config) -> void } -> void
    # NOTE: (typed config lookups) one overload per config key (the `setting` list of `config.rb`):
    #   Steep checks `config['...']` defaults in `Client` and rejects unknown keys;
    #   keep this table in sync with `setting`/`validate`;
    def []: ("retry_count") -> Integer?
          | ("retry_delay") -> Integer
          | ("retry_jitter") -> Integer
          | ("try_to_lock_timeout") -> Integer?
          | ("default_lock_ttl") -> Integer
          | ("default_queue_ttl") -> Integer
          | ("detailed_acq_timeout_error") -> bool
          | ("lock_release_batch_size") -> Integer
          | ("clear_locks_of__lock_scan_size") -> Integer
          | ("clear_locks_of__queue_scan_size") -> Integer
          | ("key_extraction_batch_size") -> Integer
          | ("instrumenter") -> RedisQueuedLocks::instrObj
          | ("uniq_identifier") -> ^() -> String
          | ("logger") -> RedisQueuedLocks::loggerObj
          | ("log_lock_try") -> bool
          | ("dead_request_ttl") -> Integer
          | ("lock_index_enabled") -> bool
          | ("lock_index_grace_period") -> Integer
          | ("is_timed_by_default") -> bool
          | ("is_auto_extended_by_default") -> bool
          | ("default_auto_extend_ttl") -> Integer?
          | ("default_max_hold_time_during_auto_extend") -> Integer?
          | ("lock_keeper.idle_timeout") -> Integer
          | ("lock_keeper.min_idle_wake_up_interval") -> Integer
          | ("lock_keeper.extension_retry_ratio") -> Integer
          | ("lock_keeper.extension_batching_ratio") -> Integer
          | ("lock_keeper.schedule_slot") -> Integer
          | ("lock_keeper.fiber_interruption_timeout") -> Integer
          | ("lock_keeper.fiber_interruption_wait_step") -> (Float | Integer)
          | ("default_conflict_strategy") -> RedisQueuedLocks::conflictStrategy
          | ("default_access_strategy") -> RedisQueuedLocks::accessStrategy
          | ("lock_priorities") -> Hash[Symbol, Integer]
          | ("default_lock_priority") -> RedisQueuedLocks::lockPriority
          | ("log_sampling_enabled") -> bool
          | ("log_sampling_percent") -> Integer
          | ("log_sampler") -> RedisQueuedLocks::Logging::samplerObj
          | ("instr_sampling_enabled") -> bool
          | ("instr_sampling_percent") -> Integer
          | ("instr_sampler") -> RedisQueuedLocks::Instrument::samplerObj
          | ("swarm.auto_swarm") -> bool
          | ("swarm.supervisor.liveness_probing_period") -> Integer
          | ("swarm.probe_hosts.enabled_for_swarm") -> bool
          | ("swarm.probe_hosts.probe_period") -> Integer
          | ("swarm.probe_hosts.redis_config.sentinel") -> bool
          | ("swarm.probe_hosts.redis_config.pooled") -> bool
          | ("swarm.probe_hosts.redis_config.config") -> Hash[untyped,untyped]
          | ("swarm.probe_hosts.redis_config.pool_config") -> Hash[untyped,untyped]
          | ("swarm.flush_zombies.enabled_for_swarm") -> bool
          | ("swarm.flush_zombies.zombie_ttl") -> Integer
          | ("swarm.flush_zombies.zombie_lock_scan_size") -> Integer
          | ("swarm.flush_zombies.zombie_queue_scan_size") -> Integer
          | ("swarm.flush_zombies.zombie_flush_period") -> Integer
          | ("swarm.flush_zombies.redis_config.sentinel") -> bool
          | ("swarm.flush_zombies.redis_config.pooled") -> bool
          | ("swarm.flush_zombies.redis_config.config") -> Hash[untyped,untyped]
          | ("swarm.flush_zombies.redis_config.pool_config") -> Hash[untyped,untyped]
    def []=: (String config_key, untyped config_value) -> void
    def slice: (String config_key_pattern) -> configState

    private

    def prevent_key__non_existent: (String config_key) -> void
    def prevent_key__invalid_type: (String config_key, untyped config_value) -> void
    def prevent_default_priority__unknown_name: (
      Hash[Symbol, Integer] lock_priorities,
      RedisQueuedLocks::lockPriority default_lock_priority
    ) -> void
  end
end
