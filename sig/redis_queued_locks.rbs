module RedisQueuedLocks
  interface _Loggable
    def debug: (?untyped? progname) { (?) -> untyped } -> untyped
  end

  interface _Instrumentable
    def notify: (String event, ?Hash[untyped,untyped] payload) -> void
  end

  type loggerObj = Object & _Loggable
  type instrObj = Object & _Instrumentable

  type readWriteMode = :read | :write
  type accessStrategy = :queued | :random
  type conflictStrategy = :wait_for_lock | :work_through | :extendable_work_through | :dead_locking
  # NOTE: (lock request priorities) an Integer priority or a priority name of
  #   `config['lock_priorities']` (resolved by `AcquireLock.acquire_lock`);
  type lockPriority = Integer | Symbol

  extend ::RedisQueuedLocks::Debugger::Interface
end
